# WrappingTooltipButton.gd
# 툴팁이 **화면 폭에 맞춰 접히는** 버튼.
#
# 왜 필요한가 (§2.35 · 2026-10-05 실측):
#   Godot 의 기본 툴팁 팝업은 **접히지 않는다**. 라벨의 `autowrap` 이 `OFF` 라서
#   팝업의 최소 폭이 곧 **문구에서 가장 긴 줄의 폭**이고, 그게 화면보다 넓으면
#   **오른쪽이 그대로 잘린다**. 팝업은 **내장 서브윈도**(`embed_subwindows` 기본 true)
#   라서 게임 창 밖으로 나갈 수도 없다.
#   실측: `BtnStage` 툴팁의 최장 줄이 **1640 px**(화면 1280) → 오른쪽 **380 px** 손실.
#   도달 가능한 (막, 라운드) 60개 중 **56개**가 그 상태였다(1막 16/20 · 2막 20/20 · 3막 20/20).
#
#   ⚠️ **위치는 클램프되지만 폭은 클램프되지 않는다** — 왼쪽 끝을 화면에 붙여도
#      남는 폭은 사라지지 않는다. 그래서 "잘리지 않게 옮기는" 방법은 없다.
#   ⚠️ 그리고 버려지는 것이 하필 **상성 절의 꼬리**다(`재생→저격·관통·유성` 같은 행동 지침).
#      §2.13-2 는 상단 바 예고를 줄이면서 "정보 손실 0"(툴팁 + 라운드 모달에 전체를 남김)을
#      주장했는데, 그 둘 중 **툴팁만** 내용을 버리고 있었다.
#
# 왜 씬 설정이 아니라 **스크립트**인가:
#   `_make_custom_tooltip()` 은 `Control` 의 가상 메서드라 **그 컨트롤 자신**에 스크립트가
#   붙어 있어야 불린다. 씬의 프로퍼티만으로는 툴팁 팝업의 그릇을 바꿀 수 없다.
#
# 왜 문구 쪽에서 줄을 나누지 않았나 (§2.35 대안 B 를 고르지 않은 이유):
#   문구에서 `\n` 을 넣으면 **폰트 계측이 UI 계층으로 들어오고**, 문구가 바뀔 때마다 다시
#   재야 하며, 그 재는 코드가 틀리면 조용히 어긋난다. 여기서는 **그릇(팝업)** 을 고치므로
#   어떤 문구가 와도 접힌다 — §2.32 가 상단 바에서 "자동 줄바꿈" 을 고른 것과 같은 판단이다.
extends Button

## 팝업이 가질 수 있는 **최대 폭**. 이보다 긴 줄은 여기서 접힌다.
##
## ⚠️ 화면 폭이 아니라 **상수**인 이유: 팝업은 마우스 옆에 뜨므로 화면 끝에 가까우면
##    왼쪽으로 클램프된다. 좁게 잡을수록 안전하고, 이 게임 툴팁의 최장 줄(1640 px)보다
##    확실히 좁아야 의미가 있다.
## ⚠️ `tools/TooltipWrapProbe` 가 이 값을 **이 스크립트에서 읽어** 판정에 쓴다 —
##    여기 숫자를 바꾸면 프로브의 판정 기준도 같이 움직인다(사본을 만들지 않았다).
const MAX_WIDTH := 520.0


func _make_custom_tooltip(for_text: String) -> Object:
	var label := Label.new()
	label.text = for_text
	# ⚠️ `AUTOWRAP_WORD_SMART` 여야 한다 — `AUTOWRAP_WORD` 는 폭보다 긴 **단어**를 쪼개지
	#    못해서, 그런 단어가 하나 있으면 최소 폭이 다시 그 단어 폭으로 돌아간다.
	#    이 게임 툴팁에는 `결계(둔화)→다른 특성` 처럼 공백 없이 긴 구간이 있다.
	label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	# 팝업은 이 컨트롤의 **결합 최소 크기**로 자기 크기를 정한다. 폭을 고정하면
	# 높이는 접힌 결과만큼 자동으로 늘어난다(그래서 세로로도 화면을 넘지 않는지 봐야 한다).
	label.custom_minimum_size = Vector2(MAX_WIDTH, 0)
	return label
