// status_tint.gdshader
//
// 적 위에 '상태' 를 색으로 얹는다. 지금은 감속(제어 타워) 하나만 쓴다.
//
// 왜 화상도 이 셰이더를 안 쓰는가 (예전 주석은 "화상·중독 같은 상태도 같은 셰이더로
// 색만 바꿔 쓸 수 있다" 고 적어 두었지만, 실제로는 못 쓴다):
//   uniform 이 status_tint / status_amount **한 쌍뿐**이라 상태 하나만 그릴 수 있다.
//   감속과 화상은 동시에 걸린다 — 질주하는 적이 제어 타워와 지속 피해 타워 사거리에
//   함께 들어가면 실제로 겹친다. 한 쌍을 더 늘리면 두 색이 섞여 둘 다 못 읽게 된다
//   (주황 + 파랑 = 탁한 색). 색 슬롯을 두 축이 나눠 쓰면 축이 하나로 뭉개진다.
//   그래서 화상은 **겹수까지 말할 수 있는 칩**으로 표현한다 — EnemyUnit 의 `_burn_badge`.
//
// 왜 modulate 로 안 하는가:
//   modulate 는 곱셈이라 채널을 **깎을 수만** 있다. 초록 적(≈0.7,0.9,0.5)에
//   파란 기운 (0.85,0.95,1.0) 을 곱하면 (0.6,0.85,0.5) — 조금 어두워질 뿐
//   파래지지 않는다. 실캡처로 확인했다(초록 184,224,128 → 162,215,128).
//   색상 자체를 옮기려면 **섞어야(mix)** 한다.
//
// 알파에 비례해 섞는 이유:
//   스프라이트의 투명한 가장자리에 색을 섞으면 실루엣이 번져 보인다.
//   c.a 를 곱하면 불투명한 몸통만 물들고 가장자리는 그대로 남는다.
shader_type canvas_item;

// 상태 색. 감속은 차가운 파랑 — 초원 배경에서 가장 멀리서도 읽힌다.
uniform vec4 status_tint : source_color = vec4(0.45, 0.78, 1.0, 1.0);
// 0.0 = 원본, 1.0 = 완전히 상태 색. 0.55 정도가 "확실히 다르지만 형태는 남는" 지점.
uniform float status_amount : hint_range(0.0, 1.0) = 0.0;

void fragment() {
	vec4 c = texture(TEXTURE, UV);
	c.rgb = mix(c.rgb, status_tint.rgb, status_amount * c.a);
	COLOR = c;
}
