; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="언어의 조각 : 무한 병합"
config/description="Hangul merge random defense — UI mockup"
run/main_scene="res://scenes/MergeMain.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=60
run/low_processor_mode=true
config/icon="res://icon.svg"

[autoload]

HangulEngine="*res://scripts/core/HangulEngine.gd"
WordDatabase="*res://scripts/core/WordDatabase.gd"
HangulStreamParser="*res://scripts/core/HangulStreamParser.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1140
window/size/window_width_override=540
window/size/window_height_override=855
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/custom="res://ui/theme/game_theme.tres"
theme/custom_font="res://fonts/neodgm.ttf"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
